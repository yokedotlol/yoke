# --- Yoke Self-Hosted Configuration -----------------------------------
# Copy this to .env and fill in your values.
# See SELF-HOSTING.md for full setup instructions.

# --- Required ---------------------------------------------------------
SHARE_SECRET=        # openssl rand -hex 32 -- HMAC secret for signed share card URLs
IP_HASH_SALT=        # openssl rand -hex 32 -- secret salt for GDPR-safe IP hashing
ADMIN_KEY=           # openssl rand -hex 32 -- protects /api/usage, /api/stats, /api/health, cache purge

# --- External APIs (optional, improve analysis quality) ---------------
# Google PageSpeed Insights API key (free at https://console.cloud.google.com)
# Enables the Speed axis with real Lighthouse/CrUX data.
# GOOGLE_PAGESPEED_API_KEY=

# WhoisFreaks API key (free tier at https://whoisfreaks.com)
# Fallback for WHOIS lookups when RDAP fails (regional TLDs, restricted registries).
# Without this, some domains will show incomplete WHOIS data.
# WHOISFREAKS_API_KEY=

# OpenRouter API key (https://openrouter.ai) -- platform-level AI analysis.
# Without this, AI Analysis tab uses only BYO keys from users.
# OPENROUTER_API_KEY=

# --- Fly Probe (optional, enables SSL grading + GeoIP) ---------------
# URL and auth secret for the Go HTTP probe deployed on Fly.io.
# Without these, SSL grading falls back to basic checks.
# FLY_PROBE_URL=https://your-probe.fly.dev
# FLY_AUTH_SECRET=     # must match PROBE_SECRET on the Fly app

# --- Cloudflare (optional, enables domain availability checks) --------
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# --- Customization (self-hosted branding) -----------------------------
# SELF_DOMAINS=yoke.example.com          # comma-separated, for self-fetch bypass
# SITE_NAME=Yoke                         # displayed in header and OG tags
# SITE_TAGLINE=open-source domain intelligence
# REPO_URL=https://github.com/yokedotlol/yoke
# FEEDBACK_URL=                          # defaults to REPO_URL/issues
# UPTIME_URL=                            # linked from footer if set
# EXTENSION_URL=                         # Chrome extension URL
# HIDE_EXTENSION=true                    # hide Chrome extension links in footer
# HIDE_CLI=true                          # hide CLI links in footer
# HIDE_GITHUB=true                       # hide GitHub repo link in footer
# DISABLE_ANALYTICS=true                 # disable endpoint usage tracking + tab view analytics

# --- Rate Limits (optional overrides) ---------------------------------
# Set to "0" to disable a specific limit. Defaults are tuned for shared hosting.
# RATE_LIMIT_ANALYZE=
# RATE_LIMIT_COMPARE=
# RATE_LIMIT_SUBDOMAIN=
# RATE_LIMIT_AVAILABILITY=
# RATE_LIMIT_RECURSIVE_DNS=

# --- Cache ------------------------------------------------------------
# CACHE_TTL_HOURS=1                      # analysis result cache TTL (default: 1 hour)

# --- MTA-STS (Docker only) --------------------------------------------
# MTA-STS MX hosts -- must match your domain's actual MX records.
# Default: Cloudflare Email Routing. Change if you use a different mail provider.
# MTA_STS_MX_1=route1.mx.cloudflare.net
# MTA_STS_MX_2=route2.mx.cloudflare.net
# MTA_STS_MX_3=route3.mx.cloudflare.net
