# ── MTA-STS policy endpoint ────────────────────────────────────────
mta-sts.{$YOKE_DOMAIN} {
    handle /.well-known/mta-sts.txt {
        respond `version: STSv1
mode: enforce
mx: route1.mx.cloudflare.net
mx: route2.mx.cloudflare.net
mx: route3.mx.cloudflare.net
max_age: 604800` 200 {
            close
        }
        header Content-Type "text/plain; charset=utf-8"
    }
    handle {
        respond "Not Found" 404
    }
}

# ── Main site ──────────────────────────────────────────────────────
{$YOKE_DOMAIN} {
    # Static assets from the client build
    @static {
        path /assets/* /fonts/* /manifest.json /apple-touch-icon.png /og-banner.png /favicon.ico
    }
    handle @static {
        root * /srv/client
        file_server
    }

    # Everything else → workerd (API + SPA fallback)
    handle {
        reverse_proxy workerd:8787
    }
}
