# ── MTA-STS policy endpoint ────────────────────────────────────────
# MX hosts must match your domain's MX records exactly.
# Default: Cloudflare Email Routing. Override via MTA_STS_MX_* env vars.
mta-sts.{$YOKE_DOMAIN} {
    handle /.well-known/mta-sts.txt {
        respond `version: STSv1
mode: enforce
mx: {$MTA_STS_MX_1}
mx: {$MTA_STS_MX_2}
mx: {$MTA_STS_MX_3}
max_age: 604800` 200 {
            close
        }
        header Content-Type "text/plain; charset=utf-8"
    }
    handle {
        respond "Not Found" 404
    }
}

# ── Main site ──────────────────────────────────────────────────────
{$YOKE_DOMAIN} {
    # Static assets from the client build
    @static {
        path /assets/* /fonts/* /manifest.json /apple-touch-icon.png /og-banner.png /favicon.ico
    }
    handle @static {
        root * /srv/client
        file_server
    }

    # Everything else → workerd (API + SPA fallback)
    handle {
        reverse_proxy workerd:8787
    }
}
