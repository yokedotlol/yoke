# ── Stage 1: Build the Yoke client (SPA) ──────────────────────────
FROM oven/bun:1-slim AS client-builder
WORKDIR /build/client
COPY client/package.json client/bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install
COPY client/ ./
# Client imports signal-registry from worker source (monorepo cross-ref)
COPY worker/src/config/ /build/worker/src/config/
# Client build.ts copies logos and OG images from repo root assets/
COPY assets/ /build/assets/
RUN bun run build

# ── Stage 2: Build the Yoke worker ────────────────────────────────
FROM oven/bun:1-slim AS worker-builder
WORKDIR /build/worker
COPY worker/package.json worker/bun.lock* ./
RUN bun install --frozen-lockfile 2>/dev/null || bun install
COPY worker/ ./
# Prompts live at repo root; worker imports them via ../../../prompts/
COPY prompts/ /build/prompts/
RUN bun run build

# ── Stage 3: Runtime (miniflare wraps workerd + local KV/D1) ──────
FROM node:22-slim

# ca-certificates needed for TLS to upstream APIs
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install miniflare (includes workerd binary + local KV/D1 backed by SQLite)
RUN npm init -y && npm install miniflare && npm cache clean --force

# Client dist (baked into image; entrypoint copies to shared volume for Caddy)
COPY --from=client-builder /build/client/dist /app/client-dist-src

# Worker artifacts
COPY --from=worker-builder /build/worker/dist/worker.js worker/dist/worker.js
COPY --from=worker-builder /build/worker/dist/resvg_bg.wasm worker/dist/resvg_bg.wasm

# Fonts for PDF generation
COPY worker/src/fonts/ worker/src/fonts/

# Miniflare server script
COPY docker/server.mjs server.mjs

# Entrypoint: copies client dist, patches domains, starts miniflare
COPY docker/entrypoint-workerd.sh entrypoint.sh
RUN chmod +x entrypoint.sh

EXPOSE 8787

ENTRYPOINT ["/app/entrypoint.sh"]
