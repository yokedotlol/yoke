name = "yoke"
main = "dist/worker.js"
compatibility_date = "2026-05-31"
# Ensures the Worker handles all requests (required for self-hosting with workerd)
run_worker = "always"
# account_id = "your-cloudflare-account-id"

[vars]
# Set to your production URL so the worker can analyze itself
# BASE_URL = "https://yourdomain.com"

[assets]
directory = "../client/dist"
binding = "ASSETS"

# D1 — historical scores + analytics (the only database you need)
[[d1_databases]]
binding = "STATS_DB"
database_name = "yoke-stats"
# database_id = "your-yoke-stats-database-id"

# KV — analysis cache + rate limiting + reference data
# Create with: npx wrangler kv namespace create REFERENCE_DATA
[[kv_namespaces]]
binding = "REFERENCE_DATA"
# id = "your-kv-namespace-id"

# Custom domain routing
# [[routes]]
# pattern = "yourdomain.com/*"
# zone_name = "yourdomain.com"

# Badge pre-warm cron — refreshes badge cache for tracked domains every hour
# Self-hosters can also use POST /api/admin/badge-sweep instead
[triggers]
crons = ["0 */1 * * *"]

# OG image rendering is now built into the main worker (og/ directory).
# The separate og-worker service binding is no longer needed.
