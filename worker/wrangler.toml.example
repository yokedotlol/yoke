name = "yoke"
main = "dist/worker.js"
compatibility_date = "2026-05-31"
# Ensures the Worker handles all requests (required for self-hosting with workerd)
run_worker = "always"
# account_id = "your-cloudflare-account-id"

[vars]
# Set to your production URL so the worker can analyze itself
# BASE_URL = "https://yourdomain.com"

[assets]
directory = "../client/dist"
binding = "ASSETS"

# D1 — historical scores + analytics (the only database you need)
[[d1_databases]]
binding = "STATS_DB"
database_name = "yoke-stats"
# database_id = "your-yoke-stats-database-id"

# KV — analysis cache + rate limiting + reference data
# Create with: npx wrangler kv namespace create REFERENCE_DATA
[[kv_namespaces]]
binding = "REFERENCE_DATA"
# id = "your-kv-namespace-id"

# Custom domain routing
# [[routes]]
# pattern = "yourdomain.com/*"
# zone_name = "yourdomain.com"

# Badge pre-warm cron — refreshes badge cache for tracked domains every hour
# Self-hosters can also use POST /api/admin/badge-sweep instead
[triggers]
crons = ["0 */1 * * *"]

# ─── Durable Objects: rate limiter ───────────────────────────────────
# Recommended backend — cheaper than the D1 default; activate by binding the DO
# + deploying + running the migration. Once RATE_LIMITER is bound the worker
# uses it automatically (default backend = "do" when the binding exists). Set
# RATE_LIMIT_BACKEND = "d1" in [vars] to force the old D1 limiter instead.
#
# In-memory, sharded across 256 DOs by IP hash for high throughput. State lives
# in RAM; a per-DO alarm GCs expired windows. Exported from src/index.ts.
[durable_objects]
bindings = [
  { name = "RATE_LIMITER", class_name = "RateLimiterDO" },
  # Single-instance global daily analysis budget (caps expensive cache-miss
  # scans per UTC day; default ceiling 3000, override with GLOBAL_ANALYSIS_BUDGET).
  { name = "ANALYSIS_BUDGET", class_name = "AnalysisBudgetDO" }
]

# The DOs use storage (alarms / durable counters) → register as SQLite-backed.
[[migrations]]
tag = "v1"
new_sqlite_classes = ["RateLimiterDO"]

# AnalysisBudgetDO added later → its own migration tag (forward-only; a DO class
# cannot be un-created by an automatic rollback).
[[migrations]]
tag = "v2"
new_sqlite_classes = ["AnalysisBudgetDO"]

# OG image rendering is now built into the main worker (og/ directory).
# The separate og-worker service binding is no longer needed.
