{
  "manifest_version": 3,
  "name": "Yoke \u2014 Domain Intelligence",
  "version": "2.2.0",
  "description": "Instant domain intelligence \u2014 headers, DNS, TLS, and more \u2014 powered by the .lol tools family.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://yoke.lol/*",
    "https://xhttp.lol/*",
    "https://ns.lol/*",
    "https://certs.lol/*"
  ],
  "action": {
    "default_title": "Analyze this domain",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}