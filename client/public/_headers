# Security headers for all HTML pages
# Belt-and-suspenders: CF Workers Assets may serve index.html for /
# before the Worker's htmlResponse() can add these headers.
/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), ambient-light-sensor=(), accelerometer=(), gyroscope=(), magnetometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-uc4Eo0eLbA2bnen9IAsmPVnrCkYfuaETrxr4nohh0Mk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://yoke.lol https://*.googleapis.com; font-src 'self'; frame-ancestors 'self' https://*.chromiumapp.org chrome-extension://*; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

# Immutable cache for content-hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Immutable cache for self-hosted fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# BIMI logo — must be accessible cross-origin for email clients
/bimi-logo.svg
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=86400
